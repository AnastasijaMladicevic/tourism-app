# Angular build output
/dist
/tmp
/out-tsc
/bazel-out

# Angular CLI cache
.angular/
.angular/cache

# Node modules
/node_modules

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript compiled files
*.tsbuildinfo

# Environment files (keep default, ignore custom/local overrides)
src/environments/*.ts
!src/environments/environment.ts

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code specific files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# History / snapshots
.history/*
__screenshots__/

# Test coverage and reports
/coverage
/test-results

# Sass / CSS cache
.sass-cache/

# Misc logs
/connect.lock
/libpeerconnection.log
testem.log

# System files
.DS_Store
Thumbs.db