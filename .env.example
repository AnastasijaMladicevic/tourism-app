# Public URL that QR codes should open.
# For real deployment use your public domain, for local smoke test use http://localhost
PUBLIC_APP_BASE_URL=https://tourist.example.com

# Host port for the tourist frontend container
FRONTEND_PORT=80

# Set false only for local/non-HTTPS smoke testing.
# For a real public deployment behind HTTPS keep this true.
REVERSE_PROXY_USE_HTTPS_REDIRECTION=true

# PostgreSQL
POSTGRES_DB=turisticka_baza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# JWT
JWT_KEY=CHANGE_THIS_WITH_AT_LEAST_32_CHARACTERS
JWT_ISSUER=TuristickiVodic
JWT_AUDIENCE=TuristickiVodicUsers

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TuristickiVodic
SMTP_ENABLE_SSL=true
