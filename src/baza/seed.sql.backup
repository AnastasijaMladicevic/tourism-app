 (SELECT "Id" FROM "Users" WHERE "Email" = 'lucia.admin@spirego.com'), NOW());

UPDATE "Localities" l
SET "CreatedByUserId" = d."ManagedByUserId",
    "UpdatedAt" = NOW()
FROM "Destinations" d
WHERE l."DestinationId" = d."Id"
  AND d."Name" IN ('Barcelona', 'Madrid', 'Valencia');

