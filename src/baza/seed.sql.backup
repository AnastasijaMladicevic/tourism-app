-- Lokalitetima upravlja menadzer dodeljen destinaciji kojoj pripadaju.
UPDATE "Localities" l
SET "CreatedByUserId" = d."ManagedByUserId",
    "UpdatedAt" = NOW()
FROM "Destinations" d
WHERE l."DestinationId" = d."Id"
  AND d."ManagedByUserId" IS NOT NULL;



